# ─────────────────────────────────────────────────────────────
#  SIP-as-a-Service Platform — Environment Variables
#  Copy to .env and fill in your values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Platform ──────────────────────────────────────────────────
PUBLIC_IP=1.2.3.4                      # Your server's public IP
DOMAIN=sip.yourdomain.com              # SIP domain customers register to

# ── Database ──────────────────────────────────────────────────
DB_USER=sipaas
DB_PASS=StrongDBPassword123!
DB_ROOT_PASS=RootPassword456!

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASS=RedisPass789!

# ── JWT (for portal/API auth) ─────────────────────────────────
JWT_SECRET=some-very-long-random-secret-change-this

# ── Asterisk AMI / ARI ────────────────────────────────────────
AMI_USER=amiuser
AMI_PASS=AmiPassword!
ARI_USER=ariuser
ARI_PASS=AriPassword!

# ── Upstream Providers ────────────────────────────────────────
# TATA Tele (IP-based trunk — they whitelist your PUBLIC_IP)
TATA_IP=203.x.x.x                     # TATA SIP gateway IP
TATA_PORT=5060
TATA_CALLER_ID=+911234567890           # CLI to send TATA

# Provider 2 — registration-based upstream
PROV2_HOST=sip.provider2.com
PROV2_PORT=5060
PROV2_USER=your_username
PROV2_PASS=your_password
PROV2_FROM_USER=your_ddi_number

# ── RTP Port Range ────────────────────────────────────────────
RTP_MIN_PORT=10000
RTP_MAX_PORT=20000

# ── Billing Rates ─────────────────────────────────────────────
RATE_PER_MIN=0.45                      # INR per minute (retail to customer)
DID_MONTHLY_RATE=500                   # INR per DID per month

# ── Dashboard / Portal ────────────────────────────────────────
# Named to match the guide (Section 3.3)
DASHBOARD_SECRET=RandomSecretKey789!          # = JWT_SECRET alias
SIP_ADMIN_USER=admin                          # platform admin SIP username
SIP_ADMIN_PASS=AdminSIPPass!                  # platform admin SIP password

# ── API & Portal ──────────────────────────────────────────────
API_PORT=3000
PORTAL_PORT=8080

# ── Monitoring ────────────────────────────────────────────────
GRAFANA_PASS=admin123
