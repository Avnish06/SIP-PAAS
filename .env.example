# ─────────────────────────────────────────────────────────────
#  SIP-as-a-Service Platform — Environment Variables
#  Copy to .env and fill in your values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Platform ──────────────────────────────────────────────────
PUBLIC_IP=1.2.3.4                      # Your server's public IP
DOMAIN=sip.yourdomain.com              # SIP domain (or IP if no DNS)

# ── Database ──────────────────────────────────────────────────
DB_USER=sipaas
DB_PASS=StrongDBPassword123!
DB_ROOT_PASS=RootPassword456!

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASS=RedisPass789!

# ── JWT (for portal/API auth) ─────────────────────────────────
JWT_SECRET=some-very-long-random-secret-change-this

# ── Asterisk AMI / ARI ────────────────────────────────────────
AMI_USER=amiuser
AMI_PASS=AmiPassword!
ARI_USER=ariuser
ARI_PASS=AriPassword!

# ── Synchrovox upstream trunk (sole carrier) ──────────────────
SYNCHROVOX_IP=20.193.182.13            # Provider SIP gateway IP
SYNCHROVOX_PORT=5060                   # Provider SIP port
SYNCHROVOX_USER=synchrovoxai_new.com   # SIP username from provider
SYNCHROVOX_PASS=1kdu9sr0a3w            # SIP password from provider
SYNCHROVOX_PREFIX=0                    # Routing prefix (prepended to DNIS)
SYNCHROVOX_CALLER_ID=00919240292847    # Outbound CLI

# ── RTP Port Range ────────────────────────────────────────────
# RTPEngine: 10000-15000 (customer leg, host-networked)
# Asterisk:  16000-16100 (carrier + WebRTC leg, bridge-networked)
# These MUST be disjoint or host-port binding will collide.
RTP_MIN_PORT=10000
RTP_MAX_PORT=15000

# ── Billing Rates ─────────────────────────────────────────────
RATE_PER_MIN=0.45                      # INR per minute (retail to customer)
DID_MONTHLY_RATE=500                   # INR per DID per month

# ── API & Portal ──────────────────────────────────────────────
API_PORT=3000
PORTAL_PORT=8080

# ── Monitoring ────────────────────────────────────────────────
GRAFANA_PASS=admin123
